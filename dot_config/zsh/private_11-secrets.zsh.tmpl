# Rendered from OpenBao by chezmoi; values never touch the repo. Every key in
# the KV entry becomes an exported var, so to add or change one:
#   bao kv patch kv/dotfiles/shell-env NAME=value && chezmoi apply
{{ range $name, $value := (vault "kv/dotfiles/shell-env").data.data -}}
export {{ $name }}={{ $value | squote }}
{{ end -}}

#!/usr/bin/env bash
# Core packages the rest of the config assumes. Re-runs whenever this file
# changes, so adding a package here installs it on the next `chezmoi apply`.
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
    echo "Homebrew not found; install it from https://brew.sh and re-run chezmoi apply" >&2
    exit 1
fi

pkgs=(zsh tmux neovim gnu-sed gawk gnu-getopt gnu-units bat ripgrep starship zoxide espanso jq)
# Any WezTerm build (e.g. wezterm@nightly) owns WezTerm.app; installing the
# stable cask over it fails and would abort the whole apply.
[ -d /Applications/WezTerm.app ] || pkgs+=(wezterm)
brew install "${pkgs[@]}"

{{- else if eq .chezmoi.os "linux" }}
if [ -f /etc/debian_version ]; then
    sudo apt-get update -q
    sudo apt-get install -yq \
        zsh tmux vim jq neovim ripgrep bat starship \
        zoxide
elif [ -f /etc/arch-release ]; then
    sudo pacman -Sy --needed --noconfirm \
        zsh tmux vim neovim wezterm ripgrep bat starship zoxide yay jq
    yay -S --needed {{ if .wayland }}espanso-wayland{{ else }}espanso-x11{{ end }}
elif [ -f /etc/redhat-release ]; then
    EL_VERSION=$(cat /etc/redhat-release)
    if [[ "$EL_VERSION" == *8.* ]]; then
        sudo dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-8.noarch.rpm
    elif [[ "$EL_VERSION" == *7.* ]]; then
        sudo dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-7.noarch.rpm
    fi
    sudo dnf install -y zsh tmux vim
fi
{{- end }}

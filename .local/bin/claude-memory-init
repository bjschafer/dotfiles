#!/usr/bin/env bash
# Register a project for cross-machine Claude Code auto-memory sync.
#
# Creates a per-project subdirectory under ~/.local/share/claude-memory
# (see memory-sync-pull.sh / memory-sync-push.sh in ~/.claude/hooks/),
# points the project's .claude/settings.local.json at it via
# autoMemoryDirectory, and pushes the directory so it exists for other
# machines. Safe to re-run; only rewrites what's needed.
#
# Usage: claude-memory-init [path-to-project]   (defaults to cwd)
set -euo pipefail

MEMORY_REPO="$HOME/.local/share/claude-memory"
MEMORY_REPO_URL="git@gitlab.cmdcentral.xyz:bschafer/claude-memory.git"
PROJECT_DIR="$(cd "${1:-.}" && pwd)"

if [ ! -d "$MEMORY_REPO/.git" ]; then
    if [ -e "$MEMORY_REPO" ]; then
        echo "error: $MEMORY_REPO exists but isn't a git repo." >&2
        exit 1
    fi
    echo "cloning $MEMORY_REPO_URL to $MEMORY_REPO..."
    mkdir -p "$(dirname "$MEMORY_REPO")"
    git clone "$MEMORY_REPO_URL" "$MEMORY_REPO"
fi

if ! command -v jq >/dev/null 2>&1; then
    echo "error: jq is required" >&2
    exit 1
fi

cd "$PROJECT_DIR"

if repo_root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    remote_url="$(git remote get-url origin 2>/dev/null || true)"
    if [ -n "$remote_url" ]; then
        name="$(basename "$remote_url" .git)"
    else
        name="$(basename "$repo_root")"
    fi
else
    repo_root="$PROJECT_DIR"
    name="$(basename "$PROJECT_DIR")"
fi

mem_dir="$MEMORY_REPO/$name/memory"
settings_file="$repo_root/.claude/settings.local.json"
default_dir="$HOME/.claude/projects/$(printf '%s' "$repo_root" | tr '/' '-')/memory"

mkdir -p "$mem_dir"

target_has_content="$(find "$mem_dir" -maxdepth 1 -type f ! -name '.gitkeep' 2>/dev/null | head -n 1)"
source_has_content="$(find "$default_dir" -maxdepth 1 -type f 2>/dev/null | head -n 1)"

if [ -n "$source_has_content" ] && [ -z "$target_has_content" ]; then
    mv "$default_dir"/* "$mem_dir"/
    rm -f "$mem_dir/.gitkeep"
    rmdir "$default_dir" 2>/dev/null || true
    echo "Migrated existing memory from $default_dir"
elif [ -n "$source_has_content" ]; then
    echo "warning: existing memory at $default_dir was NOT migrated -- $mem_dir already has content; merge manually if needed" >&2
fi

[ -z "$(find "$mem_dir" -maxdepth 1 -type f 2>/dev/null | head -n 1)" ] && touch "$mem_dir/.gitkeep"

mkdir -p "$repo_root/.claude"
if [ -f "$settings_file" ]; then
    tmp="$(mktemp)"
    jq --arg dir "$mem_dir" '.autoMemoryDirectory = $dir' "$settings_file" > "$tmp"
    mv "$tmp" "$settings_file"
else
    jq -n --arg dir "$mem_dir" '{autoMemoryDirectory: $dir}' > "$settings_file"
fi

# Commit under the shared lock so a concurrent hook can't race the index,
# then let memory-sync.sh do the fetch/rebase/push (single reconcile path).
if [ -r "$HOME/.claude/hooks/memory-sync-lib.sh" ]; then
    # shellcheck source=/dev/null
    . "$HOME/.claude/hooks/memory-sync-lib.sh"
    mem_lock 10 || { echo "warning: memory sync busy; commit deferred to next sync" >&2; exit 0; }
    git -C "$MEMORY_REPO" add -A
    if ! git -C "$MEMORY_REPO" diff --cached --quiet; then
        git -C "$MEMORY_REPO" commit -m "Add $name memory dir" --quiet
    fi
    mem_unlock
    bash "$HOME/.claude/hooks/memory-sync.sh" </dev/null >/dev/null 2>&1 || true
else
    git -C "$MEMORY_REPO" add -A
    if ! git -C "$MEMORY_REPO" diff --cached --quiet; then
        git -C "$MEMORY_REPO" commit -m "Add $name memory dir" --quiet
        git -C "$MEMORY_REPO" push --quiet
    fi
fi

echo "Configured auto-memory sync for '$name'"
echo "  memory dir: $mem_dir"
echo "  settings:   $settings_file"

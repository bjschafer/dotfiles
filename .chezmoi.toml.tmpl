{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $work  := promptBoolOnce   . "work"  "Work machine" -}}
{{- $secrets := promptBoolOnce . "secrets" "Pull shell secrets from OpenBao" (not $work) -}}
{{- $baoAddr := "https://openbao.cmdcentral.xyz" -}}
{{- $wayland := false -}}

{{- if and (lookPath "loginctl") (lookPath "sh") -}}
{{-   $count := trim (output "sh" "-c" "loginctl list-sessions --no-legend | awk '{print $1}' | xargs -r -n1 loginctl show-session --value -p Type | grep -c wayland || true") -}}
{{-   $wayland = ne $count "0" -}}

{{- else if env "XDG_RUNTIME_DIR" -}}
{{- /* No logind — fall back to checking for a Wayland socket in the runtime dir. */ -}}
{{-   range $i := list 0 1 2 3 -}}
{{-     if stat (printf "%s/wayland-%d" (env "XDG_RUNTIME_DIR") $i) -}}
{{-       $wayland = true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}

[data]
    email = {{ $email | quote }}
    work  = {{ $work }}
    wayland = {{ $wayland }}
    secrets = {{ $secrets }}
    baoAddr = {{ $baoAddr | quote }}

# Environment for chezmoi's own subprocesses, including the `vault` (bao) template function.
[env]
    BAO_ADDR = {{ $baoAddr | quote }}

[diff]
    command = "difft"
    # difft can't diff a new directory against nothing; the files inside still show
    exclude = ["dirs"]

[git]
    autoCommit = true
    commitMessageTemplate = "{{ "{{" }} promptString \"Commit message\" {{ "}}" }}"

[vault]
    # bao, but logged in as this host's read-only dotfiles AppRole when it has one
    command = {{ joinPath .chezmoi.homeDir ".local/bin/bao-dotfiles" | quote }}

[edit]
    apply = true
